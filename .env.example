# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key

# 飞书 Message
FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret

# QQ Bot
QQ_APP_ID=your_qq_app_id
QQ_APP_TOKEN=your_qq_app_token

# 相机照片
CAMERA_OUTPUT_DIR=./cache

# 文件修改权限
FILE_ALLOW_DELETE=true

# 定时任务
SCHEDULER_TIMEZONE=Asia/Shanghai
SCHEDULER_DB_PATH=./cache/scheduler/jobs.sqlite3

# robot_env
ROBOT_LIBERO_PYTHON=/home/ma/GithubDoc/openpi/.venv/bin/python
ROBOT_LIBERO_WORKDIR=/home/ma/GithubDoc/LIBERO
ROBOT_LIBERO_SOURCE_ROOT=/home/ma/GithubDoc/LIBERO

ROBOT_LIBERO_OUTPUT_DIR=/home/ma/robot-agent/cache/libero
ROBOT_LIBERO_TIMEOUT=120
ROBOT_LIBERO_START_TIMEOUT=20

# OpenPI Python 环境
ROBOT_OPENPI_PYTHON=/home/ma/GithubDoc/openpi/.venv/bin/python

# 本地 WebSocket 端口
ROBOT_OPENPI_HOST=127.0.0.1
ROBOT_OPENPI_PORT=8088

# 自动建立 SSH 隧道
# ssh -p 30789 -CNg -L 8088:127.0.0.1:8088 root@183.147.142.40
    # -p 30789	SSH 登录端口	通过服务器的 30789 端口建立 SSH 连接
    # -C	Compression	启用 SSH 数据压缩
    # -N	No command	不执行远程命令，只建立连接
    # -g	GatewayPorts	允许其他主机连接本地转发端口（具体取决于监听地址）
    # -L	Local forwarding	将远程服务端口映射到本地
    # -L 8088:127.0.0.1:8088
    # -L [本地监听地址:]本地端口:远程目标地址:远程目标端口
    # root	SSH 用户名	使用 root 账户登录
    # 183.147.142.40	SSH 服务器 IP	要连接的远程服务器地址
ROBOT_OPENPI_SSH_ENABLED=true
ROBOT_OPENPI_SSH_HOST=your_ssh_server_ip
ROBOT_OPENPI_SSH_PORT=your_ssh_port
ROBOT_OPENPI_SSH_USER=your_ssh_username
ROBOT_OPENPI_SSH_AUTH_METHOD=password
ROBOT_OPENPI_SSH_PASSWORD=your_ssh_password

# 首次连接自动接受新服务器的主机密钥
ROBOT_OPENPI_SSH_HOST_KEY_POLICY=accept-new

# 服务器上的模型端口
ROBOT_OPENPI_SSH_REMOTE_HOST=127.0.0.1
ROBOT_OPENPI_SSH_REMOTE_PORT=8000

# 超时
ROBOT_OPENPI_START_TIMEOUT=30
ROBOT_OPENPI_REQUEST_TIMEOUT=60