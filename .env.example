# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key

# 飞书 Message
FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret

# QQ Bot
QQ_APP_ID=your_qq_app_id
QQ_APP_TOKEN=your_qq_app_token

# 相机照片
CAMERA_OUTPUT_DIR=./cache

# 文件修改权限
FILE_ALLOW_DELETE=true

# 定时任务
SCHEDULER_TIMEZONE=Asia/Shanghai
SCHEDULER_DB_PATH=./cache/scheduler/jobs.sqlite3

# robot_env
ROBOT_LIBERO_PYTHON=/home/ma/GithubDoc/openpi/.venv/bin/python
ROBOT_LIBERO_WORKDIR=/home/ma/GithubDoc/LIBERO
ROBOT_LIBERO_SOURCE_ROOT=/home/ma/GithubDoc/LIBERO

ROBOT_LIBERO_OUTPUT_DIR=/home/ma/robot-agent/cache/libero
ROBOT_LIBERO_TIMEOUT=120
ROBOT_LIBERO_START_TIMEOUT=20